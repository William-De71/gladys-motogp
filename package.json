{
  "name": "gladys-motogp",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration for the MotoGP World Championship (MotoGP, Moto2, Moto3): session calendars, reminders, results, standings, scenes and widgets, from motogp.com.",
  "homepage": "https://github.com/William-De71/gladys-motogp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-motogp.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "motogp",
    "moto2",
    "moto3",
    "motorcycle-racing",
    "calendar",
    "home-automation"
  ]
}
